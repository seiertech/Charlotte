# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment / secrets
.env

# Generated pipeline artefacts.
# Ignore the noisy intermediate output (drafts, reviews, ledger, state, logs)
# but KEEP the reader-facing manuscript so chapters land in git and are readable on GitHub.
output/*
!output/.gitkeep
!output/book_outline.md
!output/book_outline_v3.md
!output/full_third_draft.md
!output/full_third_draft.pdf
!output/full_third_draft.docx
!output/final_chapters/
!output/full_first_draft.md
!output/full_second_draft.md
!output/full_second_draft.pdf
!output/full_second_draft.docx
!output/draft3/
output/draft3/_*
!output/draft4/
output/draft4/*_raw.md
output/draft4/*_evidenced.md
output/draft4/*_scrubbed.md
output/draft4/*_evidence_log.md
!output/full_fourth_draft.md
!output/full_fourth_draft.docx
!output/author_actions.md
!output/status_d4.md
!output/draft4_state.json
!output/reviews/
!output/status.md
!output/status_v3.md
